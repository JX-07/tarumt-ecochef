# Local development only. Do not commit the service-account JSON file.
DATABASE_URL=postgresql+psycopg://postgres:replace-with-your-local-password@localhost:5432/ecochef
FIREBASE_PROJECT_ID=ecochef-60697
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEOAPIFY_API_KEY=replace-with-your-geoapify-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional trained-model inference services. When unset, scans use Gemini as a fallback.
INGREDIENT_DETECTION_API_URL=
FRESHNESS_MODEL_API_URL=
# Stripe sandbox only. Rotate any key that has been pasted into chat or source control.
# Prefer a restricted test key (rk_test_...) with only the permissions this API needs.
STRIPE_API_KEY=replace-with-a-new-restricted-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-cli-forwarding-secret
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_CURRENCY=myr
# Development-only shortcut. The API also requires ECOCHEF_ENV=development and a test key.
STRIPE_SIMULATED_PAYMENTS_ENABLED=false
STRIPE_MOBILE_RETURN_URL=ecochef://marketplace/cart
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/vendor/store?stripe=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/vendor/store?stripe=complete
# Optional unless Expo enhanced push security is enabled.
EXPO_PUSH_ACCESS_TOKEN=
# Download this from Firebase Console > Project settings > Service accounts.
FIREBASE_CREDENTIALS_PATH=C:\\path\\to\\ecochef-60697-adminsdk.json
# Comma-separated browser origins allowed to call the local API.
ECOCHEF_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# If you access the web portal over your LAN, append its exact origin, for example:
# ECOCHEF_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.1:3000
