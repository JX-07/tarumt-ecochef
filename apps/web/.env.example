# Browser-visible base URL for the EcoChef API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Server-side address used by the same-origin Next.js API proxy. Keep this private.
ECOCHEF_API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Firebase Web app configuration. These values identify the Firebase project;
# never place Firebase Admin service-account credentials in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Browser-safe Stripe sandbox key used only by Connect embedded components.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-publishable-key

# Railway volume mount containing the signed Android APK.
ECOCHEF_ANDROID_APK_PATH=/app/downloads/ecochef.apk
