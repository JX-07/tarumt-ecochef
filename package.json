{
  "name": "ecochef",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:mobile": "corepack pnpm --filter @ecochef/mobile dev",
    "dev:mobile-client": "corepack pnpm --filter @ecochef/mobile dev:client",
    "dev:web": "corepack pnpm --filter @ecochef/web dev",
    "build:web": "corepack pnpm --filter @ecochef/web build",
    "start:web": "corepack pnpm --filter @ecochef/web start",
    "dev:api": "powershell -ExecutionPolicy Bypass -File infra/scripts/Start-Api.ps1",
    "check": "corepack pnpm -r check && corepack pnpm check:theme",
    "check:theme": "node scripts/check-theme-usage.mjs"
  }
}
