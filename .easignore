# EAS cloud builds only need the Expo app and the two workspace packages it imports.
# Keep backend services, local tooling, credentials, environment files, and generated
# output out of the upload archive.
/*
!/.easignore
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json

!/apps
/apps/*
!/apps/mobile
/apps/mobile/.env
/apps/mobile/.env.*
/apps/mobile/node_modules
/apps/mobile/.expo
/apps/mobile/.expo-*
/apps/mobile/dist
/apps/mobile/tmp
/apps/mobile/android
/apps/mobile/ios

!/packages
/packages/*
!/packages/contracts
!/packages/design-tokens

# Never upload common local or credential material if it appears below an included tree.
**/.git
**/.env
**/.env.*
**/.secrets
**/node_modules
**/.expo
**/*.db
**/*.sqlite3
**/*.jks
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist
